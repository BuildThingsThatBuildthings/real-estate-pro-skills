{
  "_comment": "Cadence, safety rails, and host tool locations. Copy to pipeline.json.",
  "ramp": {
    "_comment": "Posts per day. Fill block 1 to a rung, then block 2, then advance.",
    "rungs": [3, 5, 7, 8],
    "block_days": 30,
    "horizon_blocks": 2
  },
  "windows": {
    "_comment": "How posting slots are derived from your own analytics.",
    "min_records_per_hour": 8,
    "forbidden_hours": [0, 1, 2, 3, 4, 5, 6, 7, 22, 23],
    "view_reliable_platforms": ["youtube", "tiktok", "facebook"],
    "like_signal_platforms": ["instagram"],
    "view_weight": 0.75,
    "like_weight": 0.25
  },
  "timezone": {
    "_comment": "IANA name plus the UTC offsets used when converting slot times.",
    "name": "America/Chicago",
    "dst_offset_hours": -5,
    "std_offset_hours": -6,
    "dst_months": [3, 11]
  },
  "tools": {
    "post_bridge_cli": "~/.claude/skills/post-bridge/scripts/post-bridge.js",
    "post_bridge_config": "~/.config/post-bridge/config.json",
    "whisper_cli": "whisper-cli",
    "whisper_model": "~/models/ggml-medium.en.bin"
  },
  "captions": {
    "_comment": "Copy rules enforced by the linter. Add your own banned words.",
    "allow_hashtags": false,
    "allow_dashes": false,
    "proper_noun_exceptions": [],
    "banned_words": [
      "dive deep", "deep dive", "unleash", "unlock", "supercharge",
      "game-changer", "revolutionary", "disruptive", "leverage",
      "seamlessly", "effortlessly", "thought leader", "best-in-class",
      "cutting-edge", "empower", "synergy", "paradigm", "holistic",
      "click here", "learn more", "book a call", "free consultation"
    ]
  }
}
